# --- DATABASE CONFIGURATION (Prisma) ---
# Ganti dengan username, password, host, port, dan nama database PostgreSQL Anda
# Di sini kita arahkan ke database baru: 'dcota_care'
DATABASE_URL="postgresql://postgres:password@localhost:5432/dcota_care?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/dcota_care?schema=public"

# --- NEXT-AUTH CONFIGURATION ---
# Jalankan `openssl rand -base64 32` untuk generate secret key yang aman
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# --- SEED & IMPORT DEFAULTS ---
# Password default akun hasil `prisma db seed` (default: "password")
SEED_DEFAULT_PASSWORD=""
# Password awal salesman hasil import CSV (default: "123456")
IMPORT_DEFAULT_PASSWORD=""

# --- UPLOAD TOKEN ---
# Secret untuk menandatangani token upload (dipakai /api/upload-token + api/go-upload.go).
# Opsional: kalau kosong, otomatis memakai NEXTAUTH_SECRET. Set hanya bila ingin
# secret khusus yang terpisah dari NEXTAUTH_SECRET.
UPLOAD_SIGNING_SECRET=""

# --- SMTP (EMAIL) CONFIGURATION ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"

# --- CLOUDFLARE R2 (S3 COMPATIBLE) STORAGE CONFIGURATION ---
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="dcota-care"
R2_PUBLIC_URL="care.dcotasystem.work"
# Endpoint S3 API akun R2 Anda (dipakai api/go-upload.go)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# --- ANALYTICS (LOOKER STUDIO) ---
# URL embed laporan Looker Studio untuk halaman /dashboard/admin/analytics
NEXT_PUBLIC_LOOKER_STUDIO_URL=""

# --- CRON PROTECTION ---
# Jika diset, /api/cron/sync-bigquery hanya menerima request ber-header
# `Authorization: Bearer <CRON_SECRET>` (Vercel Cron mengirimnya otomatis).
# Kosongkan di lokal agar endpoint bisa dipanggil manual saat development.
CRON_SECRET=""

# --- GOOGLE BIGQUERY CREDENTIALS (CRON SYNC) ---
GCP_PROJECT_ID="your-gcp-project-id"
GCP_CLIENT_EMAIL="your-gcp-client-email@gcp-project.iam.gserviceaccount.com"
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- GOOGLE DRIVE CREDENTIALS ---
GDRIVE_PROJECT_ID="your-gdrive-project-id"
GDRIVE_CLIENT_EMAIL="your-gdrive-client-email"
GDRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
